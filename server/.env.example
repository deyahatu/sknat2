# ════════════════════════════════════════════════
# قالب متغيرات البيئة للسيرفر
# انسخ هذا الملف إلى .env وعدّل القيم حسب جهازك
# cp .env.example .env
# ════════════════════════════════════════════════

# قاعدة البيانات PostgreSQL
# عدّل: YOUR_PASSWORD = كلمة سر postgres عندك
# اسم القاعدة: sknat (لازم تنشئها قبل التشغيل)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/sknat?schema=public"

# مفتاح تشفير JWT — استخدم سلسلة عشوائية طويلة في الإنتاج
JWT_SECRET="change-this-to-a-long-random-secret-string"

# مدة صلاحية توكن تسجيل الدخول
JWT_EXPIRES_IN="7d"

# منفذ السيرفر (الافتراضي 5000)
PORT=5000

# عنوان الفرونت إند (لإعدادات CORS)
CLIENT_URL="http://localhost:5173"

# ════════════════════════════════════════════════
# إعدادات البريد الإلكتروني (Gmail SMTP)
# لإرسال أكواد تحقق التسجيل للطلاب
# ────────────────────────────────────────────────
# 1) فعّل التحقق بخطوتين على حسابك في Google
# 2) أنشئ App Password من: https://myaccount.google.com/apppasswords
# 3) ضع البريد + الـ App Password (16 خانة بدون مسافات) أدناه
# لو تركت SMTP_USER فارغاً، سيتم طباعة الكود في الـ console بدل إرساله
# ════════════════════════════════════════════════
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="منصة سكنات"

# ════════════════════════════════════════════════
# AI Chatbot (DeepSeek by default; OpenAI-compatible)
# DeepSeek key: https://platform.deepseek.com/api_keys
# ════════════════════════════════════════════════
CHATBOT_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
CHATBOT_MODEL="deepseek-chat"
CHATBOT_MAX_TOKENS="1024"

generator client {                                                                                                                                                                                                                                
    provider = "prisma-client"                                                                                                                                                                                                                      
    output   = "../src/generated/prisma"
  }                                                                                                                                                                                                                                                 
                  
  datasource db {                                                                                                                                                                                                                                   
    provider = "postgresql"
  }



  enum Role {
    STUDENT
    OWNER
    ADMIN
  }

  enum BookingStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
    PAID
    COMPLETED
  }                                                                                                                                                                                                                                                 
                  
  enum PaymentStatus {
    PENDING
    COMPLETED
    REFUNDED
  }

  enum WithdrawStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
  }

  enum RefundStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
  }

  enum TargetGender {
    MALE
    FEMALE
  }

  enum Gender {
    MALE
    FEMALE
  }

  enum PropertyKind {
    APARTMENT
    STUDIO
  }

  enum RoomKind {
    SINGLE
    DOUBLE
  }

                                                                                                                                                                                               
   
  model User {                                                                                                                                                                                                                                      
    id               String    @id @default(uuid())
    name             String
    email            String    @unique
    phone            String?   @unique
    password         String
    role             Role      @default(STUDENT)
    isActive         Boolean   @default(true)
    avatar           String?
    idNumber         String?   @unique
    idPhoto          String?   @db.Text
    gender           Gender?
    major            String?
    resetToken          String?
    resetTokenExpiry    DateTime?
    bankName            String?
    bankAccountHolder   String?
    bankAccountNumber   String?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    properties       Property[]
    bookings         Booking[]
    reviews          Review[]
    payments         Payment[]
    wallet           Wallet?
    withdrawRequests WithdrawRequest[]
    favorites        Favorite[]
    refundRequests   RefundRequest[]
    studentRatingsGiven    StudentRating[] @relation("StudentRatingsGiven")
    studentRatingsReceived StudentRating[] @relation("StudentRatingsReceived")

    @@map("users")
  }



  model Property {
    id              String   @id @default(uuid())
    title           String
    kind            PropertyKind @default(APARTMENT)
    description     String?
    address         String?
    city            String
    campus          String?
    distance        Int?
    sharedServices  String[] @default([])
    targetGender    TargetGender @default(MALE)
    otherServices   String?
    policy          String?
    bathrooms       Int      @default(1)
    area            Int?
    images          String[]
    available       Boolean  @default(true)
    studioPrice     Decimal? @db.Decimal(10, 2)
    ownerId         String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    roomVariants RoomVariant[]
    bookings     Booking[]
    reviews      Review[]
    favoritedBy  Favorite[]

    @@index([ownerId])
    @@index([city])
    @@index([available])
    @@map("properties")
  }

  model RoomVariant {
    id                 String   @id @default(uuid())
    name               String
    roomNumber         String?
    kind               RoomKind @default(SINGLE)
    capacity           Int      @default(1)
    isOccupied         Boolean  @default(false)
    partiallyOccupied  Boolean  @default(false)
    fullPrice          Decimal  @db.Decimal(10, 2)
    halfPrice          Decimal? @db.Decimal(10, 2)
    images             String[]
    services           String[] @default([])
    patternName        String?
    patternColor       String?
    propertyId         String
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    bookings Booking[]

    @@index([propertyId])
    @@map("room_variants")
  }                                                                                                                                                                                                                                                 
                  
  

  model Booking {
    id            String        @id @default(uuid())
    startDate     DateTime      @db.Date
    endDate       DateTime      @db.Date
    status        BookingStatus @default(PENDING)
    propertyId    String
    roomVariantId String
    studentId     String
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    roomVariant RoomVariant @relation(fields: [roomVariantId], references: [id], onDelete: Cascade)
    student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
    payment     Payment?
    studentRating StudentRating?
    refundRequest RefundRequest?

    @@index([studentId])
    @@index([propertyId])
    @@index([roomVariantId])
    @@index([status])
    @@map("bookings")
  }


  model Review {
    id         String   @id @default(uuid())
    rating     Int                                                                                                                                                                                                                                  
    comment    String?
    propertyId String                                                                                                                                                                                                                               
    studentId  String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)                                                                                                                                                          
    student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                    
    @@unique([propertyId, studentId])
    @@index([propertyId])
    @@map("reviews")                                                                                                                                                                                                                                
  }
                                                                                                                                                                                                                                                    


  model Payment {
    id        String        @id @default(uuid())
    amount    Decimal       @db.Decimal(10, 2)                                                                                                                                                                                                      
    status    PaymentStatus @default(PENDING)
    bookingId String        @unique                                                                                                                                                                                                                 
    studentId String
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
                                                                                                                                                                                                                                                    
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)                                                                                                                                                             
                  
    @@index([studentId])                                                                                                                                                                                                                            
    @@index([status])
    @@map("payments")                                                                                                                                                                                                                               
  }               


  model Wallet {
    id        String   @id @default(uuid())
    balance   Decimal  @default(0.00) @db.Decimal(10, 2)
    ownerId   String   @unique                                                                                                                                                                                                                      
    updatedAt DateTime @updatedAt
                                                                                                                                                                                                                                                    
    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)                                                                                                                                                                    
   
    @@map("wallets")                                                                                                                                                                                                                                
  }               



  model WithdrawRequest {
    id                 String         @id @default(uuid())
    amount             Decimal        @db.Decimal(10, 2)
    status             WithdrawStatus @default(PENDING)
    ownerId            String
    rejectionReason    String?
    bankName           String?
    bankAccountHolder  String?
    bankAccountNumber  String?
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt
    processedAt        DateTime?

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([status])
    @@map("withdraw_requests")
  }


  model StudentRating {
    id                String   @id @default(uuid())
    behaviorRating    Int
    cleanlinessRating Int
    communicationRating Int
    overallRating     Int
    comment           String?
    bookingId         String   @unique
    ownerId           String
    studentId         String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    owner   User    @relation("StudentRatingsGiven", fields: [ownerId], references: [id], onDelete: Cascade)
    student User    @relation("StudentRatingsReceived", fields: [studentId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([studentId])
    @@map("student_ratings")
  }


  model Favorite {
    id         String   @id @default(uuid())
    userId     String
    propertyId String
    createdAt  DateTime @default(now())

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    @@unique([userId, propertyId])
    @@index([userId])
    @@index([propertyId])
    @@map("favorites")
  }


  model EmailVerification {
    id          String   @id @default(uuid())
    email       String   @unique
    name        String
    phone       String
    password    String
    idNumber    String
    idPhoto     String   @db.Text
    gender      Gender
    major       String
    code        String
    expiresAt   DateTime
    attempts    Int      @default(0)
    lastSentAt  DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([expiresAt])
    @@map("email_verifications")
  }


  model RefundRequest {
    id               String       @id @default(uuid())
    bookingId        String       @unique
    studentId        String
    originalAmount   Decimal      @db.Decimal(10, 2)
    refundAmount     Decimal      @db.Decimal(10, 2)
    refundPercentage Int
    reason           String?
    status           RefundStatus @default(PENDING)
    rejectionReason  String?
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@index([studentId])
    @@index([status])
    @@map("refund_requests")
  }

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String
  userId     String
  userName   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

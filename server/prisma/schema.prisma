generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  OWNER
  ADMIN
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String?
  password         String
  role             Role      @default(STUDENT)
  avatar           String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

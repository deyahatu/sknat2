generator client {                                                                                                                                                                                                                                
    provider = "prisma-client"                                                                                                                                                                                                                      
    output   = "../src/generated/prisma"
  }                                                                                                                                                                                                                                                 
                  
  datasource db {                                                                                                                                                                                                                                   
    provider = "postgresql"
  }



  enum Role {
    STUDENT
    OWNER
    ADMIN
  }

  enum BookingStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
    PAID
    COMPLETED
  }                                                                                                                                                                                                                                                 
                  
  enum PaymentStatus {
    PENDING
    COMPLETED
    REFUNDED
  }

  enum WithdrawStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
  }

  enum TargetGender {
    MALE
    FEMALE
  }

                                                                                                                                                                                               
   
  model User {                                                                                                                                                                                                                                      
    id               String    @id @default(uuid())
    name             String
    email            String    @unique
    phone            String?   @unique
    password         String
    role             Role      @default(STUDENT)
    avatar           String?
    idNumber         String?   @unique
    idPhoto          String?   @db.Text
    resetToken          String?
    resetTokenExpiry    DateTime?
    bankName            String?
    bankAccountHolder   String?
    bankAccountNumber   String?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    properties       Property[]
    bookings         Booking[]
    reviews          Review[]                                                                                                                                                                                                                       
    payments         Payment[]
    wallet           Wallet?                                                                                                                                                                                                                        
    withdrawRequests WithdrawRequest[]
    studentRatingsGiven    StudentRating[] @relation("StudentRatingsGiven")
    studentRatingsReceived StudentRating[] @relation("StudentRatingsReceived")

    @@map("users")
  }



  model Property {                                                                                                                                                                                                                                  
    id          String   @id @default(uuid())
    title       String                                                                                                                                                                                                                              
    description String?
    address     String
    city        String
    price       Decimal  @db.Decimal(10, 2)
    rooms       Int      @default(1)
    capacityPerRoom Int   @default(1)
    studentsCount   Int   @default(0)
    targetGender    TargetGender @default(MALE)
    services        String[] @default([])
    otherServices   String?
    policy          String?
    bathrooms   Int      @default(1)
    area        Int?                                                                                                                                                                                                                                
    images      String[]
    available   Boolean  @default(true)                                                                                                                                                                                                             
    ownerId     String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
                                                                                                                                                                                                                                                    
    owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    bookings Booking[]                                                                                                                                                                                                                              
    reviews  Review[]

    @@index([ownerId])
    @@index([city])
    @@index([price])
    @@index([available])                                                                                                                                                                                                                            
    @@map("properties")
  }                                                                                                                                                                                                                                                 
                  
  

  model Booking {
    id         String        @id @default(uuid())
    startDate  DateTime      @db.Date
    endDate    DateTime      @db.Date                                                                                                                                                                                                               
    status     BookingStatus @default(PENDING)
    propertyId String                                                                                                                                                                                                                               
    studentId  String
    createdAt  DateTime      @default(now())
    updatedAt  DateTime      @updatedAt
                                                                                                                                                                                                                                                    
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)                                                                                                                                                           
    payment  Payment?
    studentRating StudentRating?

    @@index([studentId])                                                                                                                                                                                                                            
    @@index([propertyId])
    @@index([status])                                                                                                                                                                                                                               
    @@map("bookings")
  }


  model Review {
    id         String   @id @default(uuid())
    rating     Int                                                                                                                                                                                                                                  
    comment    String?
    propertyId String                                                                                                                                                                                                                               
    studentId  String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)                                                                                                                                                          
    student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                    
    @@unique([propertyId, studentId])
    @@index([propertyId])
    @@map("reviews")                                                                                                                                                                                                                                
  }
                                                                                                                                                                                                                                                    


  model Payment {
    id        String        @id @default(uuid())
    amount    Decimal       @db.Decimal(10, 2)                                                                                                                                                                                                      
    status    PaymentStatus @default(PENDING)
    bookingId String        @unique                                                                                                                                                                                                                 
    studentId String
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
                                                                                                                                                                                                                                                    
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)                                                                                                                                                             
                  
    @@index([studentId])                                                                                                                                                                                                                            
    @@index([status])
    @@map("payments")                                                                                                                                                                                                                               
  }               


  model Wallet {
    id        String   @id @default(uuid())
    balance   Decimal  @default(0.00) @db.Decimal(10, 2)
    ownerId   String   @unique                                                                                                                                                                                                                      
    updatedAt DateTime @updatedAt
                                                                                                                                                                                                                                                    
    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)                                                                                                                                                                    
   
    @@map("wallets")                                                                                                                                                                                                                                
  }               



  model WithdrawRequest {
    id                 String         @id @default(uuid())
    amount             Decimal        @db.Decimal(10, 2)
    status             WithdrawStatus @default(PENDING)
    ownerId            String
    rejectionReason    String?
    bankName           String?
    bankAccountHolder  String?
    bankAccountNumber  String?
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([status])
    @@map("withdraw_requests")
  }


  model StudentRating {
    id        String   @id @default(uuid())
    rating    Int
    comment   String?
    bookingId String   @unique
    ownerId   String
    studentId String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    owner   User    @relation("StudentRatingsGiven", fields: [ownerId], references: [id], onDelete: Cascade)
    student User    @relation("StudentRatingsReceived", fields: [studentId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([studentId])
    @@map("student_ratings")
  }

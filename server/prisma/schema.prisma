generator client {                                                                                                                                                                                                                                
    provider = "prisma-client"                                                                                                                                                                                                                      
    output   = "../src/generated/prisma"
  }                                                                                                                                                                                                                                                 
                  
  datasource db {                                                                                                                                                                                                                                   
    provider = "postgresql"
  }



  enum Role {
    STUDENT
    OWNER
    ADMIN
  }

  enum BookingStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
    PAID
    COMPLETED
  }                                                                                                                                                                                                                                                 
                  
  enum PaymentStatus {
    PENDING
    COMPLETED
    REFUNDED
  }

  enum WithdrawStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
  }

  enum RefundStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
  }

  enum TargetGender {
    MALE
    FEMALE
  }

  enum Gender {
    MALE
    FEMALE
  }

  enum PropertyKind {
    APARTMENT
    STUDIO
  }

  enum RoomKind {
    SINGLE
    DOUBLE
  }

enum ReportReason {
  OFFENSIVE
  FALSE_INFO
  HARASSMENT
  POLICY_VIOLATION
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ComplaintType {
  STUDENT_VS_OWNER
  OWNER_VS_STUDENT
}

enum ComplaintStatus {
  PENDING
  REVIEWED
  DISMISSED
}

                                                                                                                                                                                               
   
  model User {
    id               String    @id @default(uuid())
    name             String
    email            String    @unique
    phone            String?   @unique
    password         String
    role             Role      @default(STUDENT)
    isActive         Boolean   @default(true)
    blockReason      String?   @db.VarChar(200)
    blockedAt        DateTime?
    avatar           String?
    idNumber         String?   @unique
    idPhoto          String?   @db.Text
    gender           Gender?
    major            String?
    resetToken          String?
    resetTokenExpiry    DateTime?
    bankName            String?
    bankAccountHolder   String?
    bankAccountNumber   String?
    // When the user requests voluntary account deletion. Account becomes
    // inactive immediately; a scheduled job hard-deletes it after the
    // grace period. Cleared when the user logs in within the grace
    // period — that restores the account.
    deletionRequestedAt DateTime?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    properties       Property[]
    bookings         Booking[]
    reviews          Review[]
    payments         Payment[]
    wallet           Wallet?
    withdrawRequests WithdrawRequest[]
    favorites        Favorite[]
    refundRequests   RefundRequest[]
    studentRatingsGiven    StudentRating[] @relation("StudentRatingsGiven")
    studentRatingsReceived StudentRating[] @relation("StudentRatingsReceived")
    messagesSent     Message[] @relation("MessagesSent")
    messagesReceived Message[] @relation("MessagesReceived")
    pushSubscriptions PushSubscription[]
    notifications Notification[]
    reports       Report[]
    blockAppeals  BlockAppeal[]
    complaintsFiled    Complaint[] @relation("ComplaintsFiled")
    complaintsAgainst  Complaint[] @relation("ComplaintsAgainst")

    @@map("users")
  }



  model Property {
    id              String   @id @default(uuid())
    title           String
    kind            PropertyKind @default(APARTMENT)
    description     String?
    address         String?
    city            String
    campus          String?
    distance        Int?
    sharedServices  String[] @default([])
    targetGender    TargetGender @default(MALE)
    otherServices   String?
    policy          String?
    bathrooms       Int      @default(1)
    area            Int?
    images          String[]
    available       Boolean  @default(true)
    disabledByAdmin Boolean  @default(false)
    deletedAt       DateTime?
    studioPrice     Decimal? @db.Decimal(10, 2)
    ownerId         String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    roomVariants RoomVariant[]
    bookings     Booking[]
    reviews      Review[]
    favoritedBy  Favorite[]

    @@index([ownerId])
    @@index([city])
    @@index([available])
    @@map("properties")
  }

  model RoomVariant {
    id                 String   @id @default(uuid())
    name               String
    roomNumber         String?
    kind               RoomKind @default(SINGLE)
    capacity           Int      @default(1)
    area               Int?
    isOccupied         Boolean  @default(false)
    partiallyOccupied  Boolean  @default(false)
    fullPrice          Decimal  @db.Decimal(10, 2)
    halfPrice          Decimal? @db.Decimal(10, 2)
    images             String[]
    services           String[] @default([])
    patternName        String?
    patternColor       String?
    propertyId         String
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    bookings Booking[]

    @@index([propertyId])
    @@map("room_variants")
  }                                                                                                                                                                                                                                                 
                  
  

  model Booking {
    id            String        @id @default(uuid())
    startDate     DateTime      @db.Date
    endDate       DateTime      @db.Date
    status        BookingStatus @default(PENDING)
    propertyId    String
    roomVariantId String
    studentId     String
    // Snapshot of the per-bed monthly price at the moment the booking was
    // created. Locked here so an owner can't bait-and-switch by editing the
    // room price between approval and payment. Nullable for rows created
    // before this column existed.
    monthlyPrice          Decimal?  @db.Decimal(10, 2)
    parentBookingId       String?
    renewalReminderSentAt DateTime?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    roomVariant RoomVariant @relation(fields: [roomVariantId], references: [id], onDelete: Cascade)
    student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
    payment     Payment?
    studentRating StudentRating?
    refundRequest RefundRequest?
    messages    Message[]

    parentBooking Booking?  @relation("BookingRenewal", fields: [parentBookingId], references: [id], onDelete: SetNull)
    renewals      Booking[] @relation("BookingRenewal")
    complaints    Complaint[]

    @@index([studentId])
    @@index([propertyId])
    @@index([roomVariantId])
    @@index([status])
    @@index([parentBookingId])
    @@map("bookings")
  }


  model Review {
    id         String   @id @default(uuid())
    rating     Int                                                                                                                                                                                                                                  
    comment    String?
    propertyId String                                                                                                                                                                                                                               
    studentId  String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)                                                                                                                                                          
    student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                    
    @@unique([propertyId, studentId])
    @@index([propertyId])
    @@map("reviews")                                                                                                                                                                                                                                
  }
                                                                                                                                                                                                                                                    


  model Payment {
    id        String        @id @default(uuid())
    amount    Decimal       @db.Decimal(10, 2)                                                                                                                                                                                                      
    status    PaymentStatus @default(PENDING)
    bookingId String        @unique                                                                                                                                                                                                                 
    studentId String
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
                                                                                                                                                                                                                                                    
    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)                                                                                                                                                             
                  
    @@index([studentId])                                                                                                                                                                                                                            
    @@index([status])
    @@map("payments")                                                                                                                                                                                                                               
  }               


  model Wallet {
    id        String   @id @default(uuid())
    balance   Decimal  @default(0.00) @db.Decimal(10, 2)
    ownerId   String   @unique                                                                                                                                                                                                                      
    updatedAt DateTime @updatedAt
                                                                                                                                                                                                                                                    
    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)                                                                                                                                                                    
   
    @@map("wallets")                                                                                                                                                                                                                                
  }               



  model WithdrawRequest {
    id                 String         @id @default(uuid())
    amount             Decimal        @db.Decimal(10, 2)
    status             WithdrawStatus @default(PENDING)
    ownerId            String
    rejectionReason    String?
    bankName           String?
    bankAccountHolder  String?
    bankAccountNumber  String?
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt
    processedAt        DateTime?

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([status])
    @@map("withdraw_requests")
  }


  model StudentRating {
    id                String   @id @default(uuid())
    behaviorRating    Int
    cleanlinessRating Int
    communicationRating Int
    overallRating     Int
    comment           String?
    bookingId         String   @unique
    ownerId           String
    studentId         String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    owner   User    @relation("StudentRatingsGiven", fields: [ownerId], references: [id], onDelete: Cascade)
    student User    @relation("StudentRatingsReceived", fields: [studentId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([studentId])
    @@map("student_ratings")
  }


  model Favorite {
    id         String   @id @default(uuid())
    userId     String
    propertyId String
    createdAt  DateTime @default(now())

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    @@unique([userId, propertyId])
    @@index([userId])
    @@index([propertyId])
    @@map("favorites")
  }


  model EmailVerification {
    id          String   @id @default(uuid())
    email       String   @unique
    name        String
    phone       String
    password    String
    idNumber    String
    idPhoto     String   @db.Text
    gender      Gender
    major       String
    code        String
    expiresAt   DateTime
    attempts    Int      @default(0)
    lastSentAt  DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([expiresAt])
    @@map("email_verifications")
  }


  model RefundRequest {
    id               String       @id @default(uuid())
    bookingId        String       @unique
    studentId        String
    originalAmount   Decimal      @db.Decimal(10, 2)
    refundAmount     Decimal      @db.Decimal(10, 2)
    refundPercentage Int
    reason           String?
    status           RefundStatus @default(PENDING)
    rejectionReason  String?
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
    student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@index([studentId])
    @@index([status])
    @@map("refund_requests")
  }

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String
  userId     String
  userName   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  bookingId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([bookingId])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  url       String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Report {
  id         String       @id @default(uuid())
  type       String       @default("REVIEW")
  targetId   String
  reporterId String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
  @@map("reports")
}

// Long-form grievance between a student and an owner who have a booking
// relationship (the booking row is the proof of the relationship — without
// one, a complaint can't be filed). Distinct from Report (which targets a
// single piece of content): a Complaint is about a person's conduct and
// supports image/video evidence.
model Complaint {
  id            String          @id @default(uuid())
  type          ComplaintType
  complainantId String
  targetUserId  String
  bookingId     String?
  subject       String          @db.VarChar(200)
  description   String          @db.VarChar(2000)
  images        String[]        @default([])
  videoUrl      String?
  status        ComplaintStatus @default(PENDING)
  adminNote     String?         @db.VarChar(1000)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  complainant User     @relation("ComplaintsFiled", fields: [complainantId], references: [id], onDelete: Cascade)
  target      User     @relation("ComplaintsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([complainantId])
  @@index([targetUserId])
  @@index([bookingId])
  @@map("complaints")
}

model BlockAppeal {
  id         String       @id @default(uuid())
  userId     String
  message    String       @db.VarChar(500)
  status     AppealStatus @default(PENDING)
  adminNote  String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("block_appeals")
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Identities (email/phone/idNumber) that admins decided to delete from the
// platform. Stored here so the same person can't re-register with the same
// credentials and continue any abusive behaviour that prompted the deletion.
model BlockedIdentity {
  id         String   @id @default(uuid())
  email      String?  @unique
  phone      String?  @unique
  idNumber   String?  @unique
  reason     String?  @db.VarChar(200)
  blockedBy  String?
  blockedAt  DateTime @default(now())

  @@map("blocked_identities")
}
